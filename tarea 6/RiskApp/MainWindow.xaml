<Window x:Class="RiskApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:RiskApp.UserControls"
        Title="Sistema de Evaluación de Riesgos" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#181825"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#74C7EC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#11111B" Padding="30,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sistema de Evaluación de Riesgos" 
                           FontSize="20" FontWeight="Bold" Foreground="#CDD6F4"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnNewEval" Content="Nueva Evaluación" 
                            Style="{StaticResource NavButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnHistory" Content="Historial" 
                            Style="{StaticResource NavButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step indicators -->
        <Border Grid.Row="1" Background="#181825" Padding="30,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Step1Indicator" Background="#89B4FA" CornerRadius="14" 
                            Padding="12,6" Width="36" Height="28">
                        <TextBlock Text="1" Foreground="#1E1E2E" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step1Label" Text=" Datos del Proyecto" 
                               Foreground="#89B4FA" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="  ───  " Foreground="#45475A" FontSize="13" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Step2Indicator" Background="#45475A" CornerRadius="14" 
                            Padding="12,6" Width="36" Height="28">
                        <TextBlock Text="2" Foreground="#A6ADC8" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step2Label" Text=" Identificar Riesgos" 
                               Foreground="#585B70" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="  ───  " Foreground="#45475A" FontSize="13" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Step3Indicator" Background="#45475A" CornerRadius="14" 
                            Padding="12,6" Width="36" Height="28">
                        <TextBlock Text="3" Foreground="#A6ADC8" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step3Label" Text=" Evaluar Riesgos" 
                               Foreground="#585B70" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="  ───  " Foreground="#45475A" FontSize="13" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Step4Indicator" Background="#45475A" CornerRadius="14" 
                            Padding="12,6" Width="36" Height="28">
                        <TextBlock Text="4" Foreground="#A6ADC8" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step4Label" Text=" Resumen" 
                               Foreground="#585B70" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="2">
            <uc:Step1ProjectInfo x:Name="Step1" Visibility="Visible"/>
            <uc:Step2RiskIdentification x:Name="Step2" Visibility="Collapsed"/>
            <uc:Step3RiskEvaluation x:Name="Step3" Visibility="Collapsed"/>
            <uc:Step4Summary x:Name="Step4" Visibility="Collapsed"/>
        </Grid>

        <!-- Footer navigation -->
        <Border Grid.Row="3" Background="#11111B" Padding="30,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Content="← Anterior" Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnNext" Content="Siguiente →" Style="{StaticResource PrimaryButton}" Margin="0,0,0,0"/>
                    <Button x:Name="BtnSave" Content="Guardar Evaluación" Style="{StaticResource PrimaryButton}"
                            Visibility="Collapsed" Margin="8,0,0,0"/>
                    <Button x:Name="BtnPrint" Content="Exportar" Style="{StaticResource SecondaryButton}"
                            Visibility="Collapsed" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
