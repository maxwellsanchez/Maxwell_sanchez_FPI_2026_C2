<UserControl x:Class="RiskApp.UserControls.Step1ProjectInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <UserControl.Resources>
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#CDD6F4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Background="Transparent" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Datos del Proyecto" 
                   FontSize="28" FontWeight="Bold" Foreground="#CDD6F4"/>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <TextBlock Style="{StaticResource ModernLabel}" Text="Nombre del Proyecto"/>
            <TextBox x:Name="TxtProjectName" Style="{StaticResource ModernTextBox}" 
                     Width="400" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,20,0,0">
            <TextBlock Style="{StaticResource ModernLabel}" Text="Usuario Evaluador"/>
            <TextBox x:Name="TxtEvaluator" Style="{StaticResource ModernTextBox}" 
                     Width="400" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,20,0,0">
            <TextBlock Style="{StaticResource ModernLabel}" Text="Fecha de Evaluación"/>
            <TextBlock x:Name="TxtDate" Foreground="#A6ADC8" FontSize="14" 
                       Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,30,0,0">
            <TextBlock Style="{StaticResource ModernLabel}" Text="Descripción (Opcional)"/>
            <TextBox x:Name="TxtDescription" Style="{StaticResource ModernTextBox}" 
                     Width="400" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                     HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </Grid>
</UserControl>
