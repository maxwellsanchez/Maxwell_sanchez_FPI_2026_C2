<UserControl x:Class="RiskApp.UserControls.Step2RiskIdentification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <UserControl.Resources>
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#CDD6F4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#74C7EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBA0AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Identificación de Riesgos" 
                   FontSize="28" FontWeight="Bold" Foreground="#CDD6F4"/>

        <Border Grid.Row="2" Background="#313244" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource ModernLabel}" Text="Descripción del Riesgo"/>
                    <TextBox x:Name="TxtDescription" Style="{StaticResource ModernTextBox}" Width="280"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Style="{StaticResource ModernLabel}" Text="Categoría"/>
                    <ComboBox x:Name="CboCategory" Width="280" Height="36" 
                              Background="#45475A" Foreground="#CDD6F4" 
                              BorderBrush="#585B70" BorderThickness="1" FontSize="13">
                        <ComboBoxItem Content="Operacional" IsSelected="True"/>
                        <ComboBoxItem Content="Financiero"/>
                        <ComboBoxItem Content="Legal/Regulatorio"/>
                        <ComboBoxItem Content="Tecnológico"/>
                        <ComboBoxItem Content="Estratégico"/>
                        <ComboBoxItem Content="Reputacional"/>
                        <ComboBoxItem Content="Seguridad"/>
                        <ComboBoxItem Content="Recursos Humanos"/>
                        <ComboBoxItem Content="Medio Ambiente"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,0">
                    <TextBlock Style="{StaticResource ModernLabel}" Text="Consecuencias"/>
                    <TextBox x:Name="TxtConsequences" Style="{StaticResource ModernTextBox}" Width="280"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,0,0">
                    <TextBlock Style="{StaticResource ModernLabel}" Text="Plan de Mitigación"/>
                    <TextBox x:Name="TxtMitigation" Style="{StaticResource ModernTextBox}" Width="280"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" 
                            HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="BtnAddRisk" Content="+ Agregar Riesgo" 
                            Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnClearForm" Content="Limpiar" 
                            Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="4" x:Name="DgRisks" AutoGenerateColumns="False" 
                  Background="#313244" Foreground="#CDD6F4" 
                  GridLinesVisibility="None" HeadersVisibility="Column"
                  BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False"
                  RowBackground="#313244" AlternatingRowBackground="#45475A"
                  SelectionMode="Single" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140"/>
                <DataGridTextColumn Header="Consecuencias" Binding="{Binding Consequences}" Width="*"/>
                <DataGridTextColumn Header="Mitigación" Binding="{Binding MitigationPlan}" Width="*"/>
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Eliminar" Tag="{Binding Id}" 
                                    Click="BtnDeleteRisk_Click"
                                    Background="#F38BA8" Foreground="#1E1E2E" 
                                    FontSize="11" FontWeight="Bold" BorderThickness="0"
                                    Padding="8,4" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
