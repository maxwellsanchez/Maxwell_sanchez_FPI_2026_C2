<UserControl x:Class="RiskApp.UserControls.Step3RiskEvaluation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <UserControl.Resources>
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ScoreLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Evaluación de Probabilidad e Impacto" 
                   FontSize="28" FontWeight="Bold" Foreground="#CDD6F4"/>

        <TextBlock Grid.Row="2" Foreground="#A6ADC8" FontSize="13">
            <Run Text="Selecciona cada riesgo y ajusta su"/>
            <Run Text=" probabilidad" FontWeight="Bold" Foreground="#89B4FA"/>
            <Run Text=" e"/>
            <Run Text=" impacto" FontWeight="Bold" Foreground="#F38BA8"/>
            <Run Text=" (1-5)"/>
        </TextBlock>

        <ListBox Grid.Row="4" x:Name="LstRisks" Background="Transparent" 
                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#313244" CornerRadius="10" Padding="18,14" Margin="0,0,0,10"
                            BorderBrush="#45475A" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Background="{Binding RiskColor}" CornerRadius="4" 
                                        Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" Foreground="White" 
                                               FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding Description}" Foreground="#CDD6F4" 
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource ModernLabel}" Text="Probabilidad (1-5)"/>
                                    <Slider x:Name="SliderProbability" Minimum="1" Maximum="5" 
                                            Value="{Binding Probability, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Width="200" HorizontalAlignment="Left"
                                            Foreground="#89B4FA"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource ModernLabel}" Text="Impacto (1-5)"/>
                                    <Slider x:Name="SliderImpact" Minimum="1" Maximum="5" 
                                            Value="{Binding Impact, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Width="200" HorizontalAlignment="Left"
                                            Foreground="#F38BA8"/>
                                </StackPanel>

                                <Border Grid.Column="4" Background="{Binding RiskColor}" 
                                        CornerRadius="8" Width="80" Height="60" 
                                        VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Score" Foreground="White" FontSize="10" 
                                                   HorizontalAlignment="Center" Opacity="0.8"/>
                                        <TextBlock Text="{Binding RiskScore}" Style="{StaticResource ScoreLabel}" 
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="4" Foreground="#A6ADC8" FontSize="11" Margin="0,6,0,0">
                                <Run Text="Nivel: "/>
                                <Run Text="{Binding RiskLevel, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text="  |  "/>
                                <Run Text="Consecuencias: "/>
                                <Run Text="{Binding Consequences, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" x:Name="TxtNoRisks" Text="No hay riesgos definidos. Regresa al paso anterior."
                   Foreground="#A6ADC8" FontSize="16" HorizontalAlignment="Center" 
                   VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</UserControl>
