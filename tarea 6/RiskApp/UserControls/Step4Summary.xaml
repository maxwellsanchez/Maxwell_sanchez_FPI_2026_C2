<UserControl x:Class="RiskApp.UserControls.Step4Summary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,30,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Resumen de Evaluación" 
                       FontSize="28" FontWeight="Bold" Foreground="#CDD6F4"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Border Background="#313244" CornerRadius="10" Padding="20,16" Margin="0,0,12,0" Width="200">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Proyecto"/>
                        <TextBlock x:Name="TxtProject" Style="{StaticResource CardValue}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#313244" CornerRadius="10" Padding="20,16" Margin="6,0,6,0" Width="200">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Evaluador"/>
                        <TextBlock x:Name="TxtEvaluator" Style="{StaticResource CardValue}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#313244" CornerRadius="10" Padding="20,16" Margin="6,0,6,0" Width="200">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Fecha"/>
                        <TextBlock x:Name="TxtDate" Style="{StaticResource CardValue}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#313244" CornerRadius="10" Padding="20,16" Margin="6,0,6,0" Width="200">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Total Riesgos"/>
                        <TextBlock x:Name="TxtTotal" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#313244" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Detalle de Riesgos"/>
                        <DataGrid x:Name="DgSummary" AutoGenerateColumns="False" 
                                  Background="Transparent" Foreground="#CDD6F4"
                                  GridLinesVisibility="None" HeadersVisibility="Column"
                                  BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False"
                                  RowBackground="Transparent" AlternatingRowBackground="#3B3B4F"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Riesgo" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="110"/>
                                <DataGridTextColumn Header="Prob." Binding="{Binding Probability}" Width="50"/>
                                <DataGridTextColumn Header="Imp." Binding="{Binding Impact}" Width="50"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding RiskScore}" Width="55"/>
                                <DataGridTemplateColumn Header="Nivel" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RiskColor}" CornerRadius="4" 
                                                    Padding="6,2" HorizontalAlignment="Left" Margin="4,0">
                                                <TextBlock Text="{Binding RiskLevel}" Foreground="White" 
                                                           FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Background="#313244" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Distribución por Nivel"/>
                            <StackPanel x:Name="PnlDistribution" Orientation="Vertical"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#313244" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Por Categoría"/>
                            <StackPanel x:Name="PnlCategories" Orientation="Vertical"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
